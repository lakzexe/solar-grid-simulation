# MongoDB Connection (Select 'Python' when copying from Atlas or Railway)
# Local: mongodb://127.0.0.1:27017
# Atlas/Railway: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://127.0.0.1:27017
DB_NAME=solargrid

# Authentication secret (Generate a long random string for production)
JWT_SECRET=solargrid-secret-key-production-ready-2026

# Optional: Google Gemini AI Key (for automated plain-language briefings)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Cookie Security Settings
# Local development: COOKIE_SAMESITE=lax, COOKIE_SECURE=false
# Production cross-domain (if not using Vercel rewrites): COOKIE_SAMESITE=none, COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
